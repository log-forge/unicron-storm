# Requested workload containers. If Unicron accepts only a subset for monitoring,
# quick-load runs the monitored subset and reports the cap in the summary.
QUICK_LOAD_CONTAINERS=1
QUICK_LOAD_LOGS_PER_SEC=1000
QUICK_LOAD_DURATION_SECONDS=60
QUICK_LOAD_RAMP_SECONDS=30
QUICK_LOAD_UNICRON_BASE_URL=https://localhost:8444
QUICK_LOAD_UNICRON_ADMIN_PASSWORD=replace-with-local-admin-password
